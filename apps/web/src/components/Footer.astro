---
// Site footer — same on every page. Pre-beta note + minimal links.
import { FOUNDER_URL } from "../lib/site-jsonld.ts";
---

<footer class="foot">
  {/* Our About: what nlqdb is and who built it, with the maker's seal
      (always shown inline here; script loaded in Base.astro). */}
  <span class="foot-maker">
    <span>&copy; nlqdb &middot; Pre-beta &middot; Built by <a href={FOUNDER_URL}>Omer Hochman</a></span>
    <hochly-seal inline></hochly-seal>
  </span>
  <span>
    <a href="/manifesto/">Manifesto</a>
    &middot;
    <a href="/architecture/">Architecture</a>
    &middot;
    <a href="/integrations/">Integrations</a>
    &middot;
    <a href="/solve/">Solve</a>
    &middot;
    <a href="/vs/">Compare</a>
    &middot;
    {/* The two agent-memory wedge solve pages Google has NEVER crawled
        (2+ weeks): linking them only from `/solve/` (weakly crawled) and
        `/agents/` (last crawled before those links existed) never reached
        the crawl queue. A site-wide footer link routes them through the
        homepage + frequently-crawled indexed pages — reach R-10 crawl
        lever, same mechanism as Benchmarks / Security below. */}
    <a href="/solve/build-vs-buy-agent-memory/">Build vs buy memory</a>
    &middot;
    <a href="/solve/expire-old-agent-memory/">Expire agent memory</a>
    &middot;
    <a href="/blog/">Blog</a>
    &middot;
    {/* EK-03 — the expert-knowledge trust surface. Footer-linked so the
        new page is not a sitemap-only orphan to crawlers. */}
    <a href="/experts/">Become AI</a>
    &middot;
    {/* Sitemap-only otherwise (an orphan to crawlers); the footer link
        gives this reference asset a site-wide inbound link — reach R-10(b),
        the same reason the hall of fame is linked below. */}
    <a href="/agent-memory-benchmarks/">Benchmarks</a>
    &middot;
    <a href="/privacy/">Privacy</a>
    &middot;
    <a href="/terms/">Terms</a>
    &middot;
    {/* The one internal link to the hall of fame — advertised by
        SECURITY.md / security.txt but otherwise sitemap-only (an orphan
        to crawlers, despite being the site's top organic click-earner). */}
    <a href="/security/hall-of-fame/">Security</a>
    &middot;
    <a href="mailto:hello@nlqdb.com">Contact</a>
  </span>
</footer>
