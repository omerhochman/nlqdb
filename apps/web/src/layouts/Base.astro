---
import "../styles/global.css";
import { APP_CANONICAL_ORIGIN } from "../lib/app-href.ts";
import { organizationJsonLd, webSiteJsonLd } from "../lib/site-jsonld.ts";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  /** Path or URL of the social-share image; resolved to an absolute URL.
      Defaults to the site-wide card. Per-page images can be passed later. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Keep the page out of search indexes (auth/transactional pages —
      Google otherwise soft-404s their JS-shell render). */
  noindex?: boolean;
}

const { title, description, canonical, ogImage, ogImageAlt, noindex } = Astro.props;
// CF Static Assets serves `<route>/index.html`, so the trailing-slash URL is
// the 200 and the bare path 301-redirects (SK-WEB-027; astro.config
// `trailingSlash: "always"`). `Astro.url.pathname` doesn't carry the slash at build
// (withastro/astro#12833), so normalise here to keep canonical + og:url on
// the non-redirecting URL — a bare canonical points crawlers at a redirect of
// the page declaring it, diluting the AEO/SEO signal.
const canonicalPath = canonical ?? Astro.url.pathname;
// `/app/*` pages live on the app host — `nlqdb.com/app/*` only 301s there
// (SK-AUTH-016), so a canonical built from `Astro.site` would point every
// crawler at a redirect of the page declaring it. Keep them self-referential
// on `app.nlqdb.com` instead (SK-WEB-023's self-referential-canonical posture).
const isAppPage = canonicalPath === "/app" || canonicalPath.startsWith("/app/");
const canonicalBase = isAppPage ? APP_CANONICAL_ORIGIN : Astro.site;
const canonicalURL = new URL(
  canonicalPath.endsWith("/") ? canonicalPath : `${canonicalPath}/`,
  canonicalBase,
);
const ogImageURL = new URL(ogImage ?? "/og-default.png", Astro.site);
const ogImageAltText =
  ogImageAlt ??
  "nlqdb — analytical memory for AI agents; a database your agent queries in English.";

// Homepage-only site-wide entity nodes (lib/site-jsonld.ts) — Organization
// (brand authority) + WebSite (site name + publisher link). Site-wide nodes
// belong on the root, not every page. No per-page SoftwareApplication node:
// it is rich-result-ineligible without honest ratings/reviews and so errored
// on every page (SK-WEB-014); the brand entity is carried by Organization +
// WebSite here and by BlogPosting's Organization `@id` on posts.
const siteEntityJsonLd =
  canonicalURL.pathname === "/" && Astro.site
    ? [organizationJsonLd(Astro.site), webSiteJsonLd(Astro.site)]
    : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0c0b" />

    {/* Legacy-browser boot guard — upholds SK-WEB-001's "no blank screens,
        no dead-ended onboarding" floor. The create path
        (`lib/anon.ts` → `crypto.randomUUID`) and bundled deps (`Array.prototype.at`)
        use APIs shipped ~Chrome 92 / Safari 15.4 (mid-2021). On older browsers they
        throw at hydration and dead-end onboarding (rnd@ boot alerts, 2026-08-22:
        "t.entries.at is not a function", "window.crypto.randomUUID is not a function").
        Runtime APIs aren't transpiled, so this dependency-free inline shim — running
        before any deferred module bundle — is the fix. `crypto.getRandomValues`
        (Chrome 11+) backs the UUID fallback and is already assumed by the boot-fallback
        reporter below. Placed early in `<head>` so it is in effect before hydration. */}
    <script is:inline>
      (function () {
        try {
          var atFn = function (n) {
            n = Math.trunc(n) || 0;
            if (n < 0) n += this.length;
            return n < 0 || n >= this.length ? undefined : this[n];
          };
          if (!Array.prototype.at) {
            Object.defineProperty(Array.prototype, "at", { value: atFn, writable: true, configurable: true });
          }
          if (!String.prototype.at) {
            Object.defineProperty(String.prototype, "at", { value: atFn, writable: true, configurable: true });
          }
          if (window.crypto && !window.crypto.randomUUID && window.crypto.getRandomValues) {
            var hex = [];
            for (var i = 0; i < 256; i++) hex[i] = (i + 0x100).toString(16).slice(1);
            window.crypto.randomUUID = function () {
              var b = window.crypto.getRandomValues(new Uint8Array(16));
              b[6] = (b[6] & 0x0f) | 0x40;
              b[8] = (b[8] & 0x3f) | 0x80;
              return (
                hex[b[0]] + hex[b[1]] + hex[b[2]] + hex[b[3]] + "-" +
                hex[b[4]] + hex[b[5]] + "-" +
                hex[b[6]] + hex[b[7]] + "-" +
                hex[b[8]] + hex[b[9]] + "-" +
                hex[b[10]] + hex[b[11]] + hex[b[12]] + hex[b[13]] + hex[b[14]] + hex[b[15]]
              );
            };
          }
        } catch (_) {
          /* a polyfill failure must never itself break boot */
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL.toString()} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="nlqdb" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:image" content={ogImageURL.toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAltText} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.toString()} />
    <meta name="twitter:image:alt" content={ogImageAltText} />
    {/* Strips query/path from cross-origin Referer — default privacy hygiene for outbound links. */}
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Blog RSS autodiscovery — feed readers + dev.to/Medium/Hashnode import find /rss.xml from any page. */}
    <link rel="alternate" type="application/rss+xml" title="nlqdb blog" href="/rss.xml" />

    {siteEntityJsonLd.map((ld) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </head>
  <body>
    <slot />

    {/* The seal — the maker's way-home link to omer.hochly.com, vendored
        byte-for-byte from omerhochman/omer `seal/hochly-seal.js` (never edit
        it; biome ignores it). Self-hosted, a plain link: loads and sends
        nothing. Marketing hosts only — `/app` pages keep the bottom-right
        corner for the Tawk widget (SK-WEB-025). */}
    {!isAppPage && (
      <>
        <script is:inline src="/hochly-seal.js" defer></script>
        <hochly-seal></hochly-seal>
      </>
    )}

    {/* SK-GTM-007 — record the first external touch (UTM / referrer /
        landing) on every page; first write wins. Bundled (not inline)
        so it shares lib/attribution.ts with the create path. */}
    <script>
      import { captureFirstTouch } from "../lib/attribution";
      captureFirstTouch();
    </script>

    {/* GLOBAL-024 — the late-bound demand-signal hook `lib/logsnag.ts` emits
        through; absent env (dev, preview) renders nothing and every emit
        stays a no-op. Inline + dependency-free per GLOBAL-034: marketing
        pages stay SDK-free. Channel = the event's dot-prefix (`solve.…` →
        `solve`); LogSnag accepts unseen channels (verified live 2026-07-29). */}
    {
      import.meta.env.PUBLIC_LOGSNAG_TOKEN && import.meta.env.PUBLIC_LOGSNAG_PROJECT && (
        <script
          is:inline
          define:vars={{
            lsToken: import.meta.env.PUBLIC_LOGSNAG_TOKEN,
            lsProject: import.meta.env.PUBLIC_LOGSNAG_PROJECT,
          }}
        >
          window.__nlqdb_logsnag = function (event, props) {
            try {
              var tags = {};
              for (var k in props || {}) {
                var v = (props || {})[k];
                if (v == null) continue;
                tags[k.toLowerCase().replace(/[^a-z0-9-]/g, "-")] =
                  typeof v === "boolean" || typeof v === "number" ? v : String(v).slice(0, 120);
              }
              fetch("https://api.logsnag.com/v1/log", {
                method: "POST",
                keepalive: true,
                headers: {
                  "Content-Type": "application/json",
                  Authorization: "Bearer " + lsToken,
                },
                body: JSON.stringify({
                  project: lsProject,
                  channel: String(event).split(".")[0] || "web",
                  event: event,
                  tags: tags,
                }),
              }).catch(function () {});
            } catch (e) {
              /* analytics never interrupts the flow — GLOBAL-012 */
            }
          };
        </script>
      )
    }

    {/* SK-WEB-001 — pre-hydration recovery panel for crashes before `DOMContentLoaded`; the boot script below gates the reveal and the CSS overlay covers the viewport if it ever fires. */}
    <div id="boot-fallback" hidden role="alert">
      <div class="boot-fallback__card">
        <h2 class="boot-fallback__title">Something broke on this page.</h2>
        <p class="boot-fallback__lede">
          The error has been recorded. Reload to recover; if it persists, sign out and back in.
        </p>
        <p id="boot-fallback-reason" class="boot-fallback__reason"></p>
        <div class="boot-fallback__actions">
          <button id="boot-fallback-reload" type="button" class="btn btn--accent">Reload</button>
          <a class="btn" href="/auth/sign-out/">Sign out</a>
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ apiBase: import.meta.env.PUBLIC_API_BASE ?? "" }}>
      (function () {
        var revealed = false;
        var seen = {};
        var seenCount = 0;
        function extractMessage(e) {
          if (!e) return "Script error.";
          if (e.error && e.error.message) return String(e.error.message);
          if (e.message) return String(e.message);
          var r = e.reason;
          if (r && r.message) return String(r.message);
          if (typeof r === "string") return r;
          return "Unhandled error.";
        }
        // Hand-copy of `lib/boot-fallback.ts#EXTENSION_PREFIXES` — `is:inline` can't import; the sync test in `boot-fallback.test.ts` pins drift.
        var EXTENSION_PREFIXES = [
          "chrome://",
          "chrome-extension://",
          "moz-extension://",
          "safari-web-extension://",
          "safari-extension://",
          "webkit-masked-url://",
          "https://embed.tawk.to/",
          "https://va.tawk.to/",
          "https://cdn.tawk.to/",
        ];
        function isExternalNoise(e, message) {
          if (message === "Script error.") return true;
          var filename = e && e.filename ? String(e.filename) : "";
          if (!filename) return false;
          for (var i = 0; i < EXTENSION_PREFIXES.length; i++) {
            if (filename.indexOf(EXTENSION_PREFIXES[i]) === 0) return true;
          }
          return false;
        }
        // Hand-copy of `lib/error-report.ts#newTraceparent` so the server-side span attaches to a real W3C trace context.
        function genHex(bytes) {
          var arr = new Uint8Array(bytes);
          crypto.getRandomValues(arr);
          var out = "";
          for (var i = 0; i < arr.length; i++) {
            out += arr[i].toString(16).padStart(2, "0");
          }
          return out;
        }
        function newTraceparent() {
          return "00-" + genHex(16) + "-" + genHex(8) + "-01";
        }
        function report(message) {
          var stack = (message || "").slice(0, 200);
          var fp = "boot::" + message + "::" + stack;
          if (seen[fp]) return;
          if (seenCount >= 32) { seen = {}; seenCount = 0; }
          seen[fp] = 1; seenCount++;
          try {
            fetch(apiBase + "/v1/errors/web", {
              method: "POST",
              headers: {
                "content-type": "application/json",
                traceparent: newTraceparent(),
              },
              credentials: "omit",
              keepalive: true,
              body: JSON.stringify({
                surface: "boot",
                message: message,
                // No fragment: `#nlq=` carries the SK-ANON-015 anon bearer, and
                // a boot error can fire before the page strips it.
                href: location.href.split("#")[0],
                userAgent: navigator.userAgent,
              }),
            }).catch(function () {});
          } catch (_) {}
        }
        function reveal(message) {
          // Post-`DOMContentLoaded` throws are ErrorBoundary's or the report pipeline's; the CSS overlay is the second line if this guard ever regresses.
          if (window.__nlqdbBooted) {
            report(message);
            return;
          }
          if (revealed) { report(message); return; }
          revealed = true;
          try {
            var node = document.getElementById("boot-fallback");
            if (node) {
              node.hidden = false;
              var r = document.getElementById("boot-fallback-reason");
              if (r && message) r.textContent = message.slice(0, 240);
            }
          } catch (_) {}
          report(message);
        }
        function onError(e) {
          var message = extractMessage(e);
          if (isExternalNoise(e, message)) return;
          reveal(message);
        }
        window.addEventListener("error", onError);
        window.addEventListener("unhandledrejection", onError);
        // Close the reveal gate on every page once HTML parses — ErrorBoundary also sets this flag, whichever fires first wins.
        function markBooted() { window.__nlqdbBooted = true; }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", markBooted);
        } else {
          markBooted();
        }
        document.addEventListener("DOMContentLoaded", function () {
          var btn = document.getElementById("boot-fallback-reload");
          if (btn) btn.addEventListener("click", function () { location.reload(); });
        });
      })();
    </script>
  </body>
</html>
